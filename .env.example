# OWN-AI Environment Configuration

# Database
DATABASE_URL=sqlite:///./ownai.db
# For PostgreSQL: postgresql://user:password@localhost:5432/ownai

# Authentication
JWT_SECRET=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=ownai-datasets

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# GPU Cloud Providers (optional)
MODAL_API_KEY=your-modal-api-key
RUNPOD_API_KEY=your-runpod-api-key
LAMBDA_API_KEY=your-lambda-api-key

# Model Storage
MODEL_STORAGE_PATH=/var/ownai/models
# Or S3: s3://your-bucket/models

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn

# Development
DEBUG=true
LOG_LEVEL=info
